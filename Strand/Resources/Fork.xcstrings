      }
    },
    "strap" : {
      "comment" : "Source caption under a step count (measured by the strap).",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "fascia"
          }
        }
      }
    },
    "≥ %lld bpm" : {
      "comment" : "HR zone legend: Zone 5, from its start upwards.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "≥ %lld bpm"
          }
        }
      }
    }
  },
  "version" : "1.0"
