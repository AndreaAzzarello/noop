    },
    "Each pass rewrites only the vitals, nights, heart-rate hours and workouts that changed, and everything again once a day or after an update. Turn it off to rewrite all of it on every pass." : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni passata riscrive solo parametri vitali, notti, ore di frequenza cardiaca e allenamenti cambiati, e tutto di nuovo una volta al giorno o dopo un aggiornamento. Disattivalo per riscrivere tutto a ogni passata."
          }
        }
      }
    },
    "Earlier wake in light sleep" : {
      "comment" : "Smart Wake card title.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
