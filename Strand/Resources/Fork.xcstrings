{
  "sourceLanguage" : "en",
  "strings" : {
    "%@, under %lld beats per minute" : {
      "comment" : "VoiceOver label for the below-Zone-1 legend entry.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, sotto %2$lld battiti al minuto"
          }
        }
      }
    },
    "%lld–%lld bpm" : {
      "comment" : "HR zone legend: first and last bpm of a zone.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld–%lld bpm"
          }
        }
      }
    },
    "< %lld bpm" : {
      "comment" : "HR zone legend: heart rate strictly below the Zone 1 start.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "< %lld bpm"
          }
        }
      }
    },
    "Alarm permission was revoked in Settings." : {
      "comment" : "Display text for SmartWakeAlarmScheduler.revokedAuthorizationMessage (the stored value stays English).",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il permesso per le sveglie è stato revocato in Impostazioni."
          }
        }
      }
    },
    "Copied" : {
      "comment" : "Button label after copying the diagnostics report ('Copy' is an upstream key).",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiato"
          }
        }
      }
    },
    "Custom times for individual days are included automatically." : {
      "comment" : "Footnote shown when per-day overrides exist.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli orari personalizzati dei singoli giorni sono inclusi automaticamente."
          }
        }
      }
    },
    "Earlier wake in light sleep" : {
      "comment" : "Smart Wake card title.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sveglia anticipata nel sonno leggero"
          }
        }
      }
    },
    "Early window" : {
      "comment" : "Smart Wake card row label and hidden picker title: how long before the maximum time an early wake may fire.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finestra di anticipo"
          }
        }
      }
    },
    "Enable Smart Wake" : {
      "comment" : "Smart Wake card toggle.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva Smart Wake"
          }
        }
      }
    },
    "If you don't double-tap the strap, it vibrates again every %lld minutes, up to %lld times. A double tap stops it and the iPhone alarm." : {
      "comment" : "Footnote under the insistent toggle. First number: minutes between vibrations. Second: maximum number of repeats. Both come from InsistentWakeAlarm.Configuration.insistent.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se non tocchi due volte la fascia, vibra di nuovo ogni %1$lld minuti, fino a %2$lld volte. Un doppio tocco la ferma insieme alla sveglia dell'iPhone."
          }
        }
      }
    },
    "Insistent strap alarm" : {
      "comment" : "Smart Wake card toggle.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sveglia insistente sulla fascia"
          }
        }
      }
    },
    "Maximum wake" : {
      "comment" : "Smart Wake card row label; the value is the next maximum wake time, e.g. 'Tue 7:00'. Keep short.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sveglia al più tardi"
          }
        }
      }
    },
    "NOOP could not schedule the system alarm. Check the Alarms permission and try again." : {
      "comment" : "Generic error under the Smart Wake card when AlarmKit scheduling fails. A technical detail line may follow it (English).",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOOP non è riuscito a programmare la sveglia di sistema. Controlla il permesso per le sveglie e riprova."
          }
        }
      }
    },
    "NOOP estimates light sleep from WHOOP heart rate and beat intervals and wakes you earlier inside the window, with the strap and the iPhone. It is an estimate, not a measured sleep stage. If samples are missing or insufficient, the maximum-time AlarmKit alarm remains scheduled." : {
      "comment" : "Smart Wake card explanation footnote.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOOP stima il sonno leggero dalla frequenza cardiaca e dagli intervalli tra i battiti del WHOOP e ti sveglia prima, dentro la finestra, con la fascia e l'iPhone. È una stima, non una fase del sonno misurata. Se i campioni mancano o non bastano, resta programmata la sveglia AlarmKit all'orario massimo."
          }
        }
      }
    },
    "No active wake days" : {
      "comment" : "Value of the 'Maximum wake' row when every weekday is off.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun giorno di sveglia attivo"
          }
        }
      }
    },
    "Not started: %@" : {
      "comment" : "Fallback result line of the strap alarm test; %@ is an English technical reason.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non avviato: %@"
          }
        }
      }
    },
    "Not started: Smart Wake is not running" : {
      "comment" : "Result line of the strap alarm test.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non avviato: Smart Wake non è attivo"
          }
        }
      }
    },
