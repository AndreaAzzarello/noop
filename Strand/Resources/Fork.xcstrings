      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non avviato: è in corso una sveglia"
          }
        }
      }
    },
    "Not started: alarm permission not granted" : {
      "comment" : "Result of the iPhone alarm test in the Smart Wake diagnostics.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non avviata: permesso per le sveglie non concesso"
          }
        }
      }
    },
    "Not started: the 5/MG firmware alarm needs Protocol probes" : {
      "comment" : "Result line of the strap alarm test. 'Protocol probes' is a Test Centre setting.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non avviato: la sveglia firmware 5/MG richiede le sonde di protocollo"
          }
        }
      }
    },
    "Not started: the app is not ready" : {
      "comment" : "Result line of the strap alarm test.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non avviato: l'app non è pronta"
          }
        }
      }
    },
    "Not started: the strap is not connected" : {
      "comment" : "Result line of the strap alarm test.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non avviato: la fascia non è connessa"
          }
        }
      }
    },
    "Not started: the system refused the alarm" : {
      "comment" : "Result of the iPhone alarm test in the Smart Wake diagnostics.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non avviata: il sistema ha rifiutato la sveglia"
          }
        }
      }
    },
    "Restore Smart Wake fallback" : {
      "comment" : "AppIntent title (not discoverable).",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripristina la sveglia di riserva Smart Wake"
          }
        }
      }
    },
    "SMART WAKE" : {
      "comment" : "Smart Wake card overline (Alarms screen). Feature name kept as is.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMART WAKE"
          }
        }
      }
    },
    "Skip current occurrence" : {
      "comment" : "AppIntent parameter title (not discoverable).",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta l'occorrenza corrente"
          }
        }
      }
    },
    "Smart Wake" : {
      "comment" : "Title of the system alarm alert shown by AlarmKit. Alarms are matched by UUID, never by this text.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Wake"
          }
        }
      }
    },
    "Smart Wake early window" : {
      "comment" : "VoiceOver label of the early-window picker.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finestra di anticipo di Smart Wake"
          }
        }
      }
    },
    "Start" : {
      "comment" : "Workout review sheet: label of the start-time picker (a noun; upstream 'Start' means the verb).",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizio"
          }
        }
      }
    },
    "Stop Smart Wake test alarm" : {
      "comment" : "Title of the stop intent of the iPhone test alarm (never shown).",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferma la sveglia di prova Smart Wake"
          }
        }
      }
    },
    "System Smart Wake alarms require iOS 26 or later." : {
      "comment" : "Shown on iOS versions older than 26.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sveglie di sistema Smart Wake richiedono iOS 26 o successivo."
          }
        }
      }
    },
    "Technical detail" : {
      "comment" : "Label before the English AlarmKit error text under the Smart Wake card.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dettaglio tecnico"
          }
        }
      }
    },
    "Test alarm armed for %@" : {
      "comment" : "Result of the iPhone alarm test; the argument is a clock time.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sveglia di prova programmata per le %@"
          }
        }
      }
    },
    "Test iPhone alarm in 1 minute" : {
      "comment" : "Button in the Smart Wake diagnostics.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova la sveglia dell'iPhone tra 1 minuto"
          }
        }
      }
    },
    "Test started: the strap should vibrate in about a minute. Double-tap it to stop." : {
      "comment" : "Result line of the strap alarm test.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test avviato: la fascia dovrebbe vibrare tra circa un minuto. Toccala due volte per fermarla."
          }
        }
      }
    },
    "Test strap alarm in 1 minute" : {
      "comment" : "Button in the Smart Wake diagnostics.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova la sveglia della fascia tra 1 minuto"
          }
        }
      }
    },
    "The wake-alarm above buzzes your wrist from the strap's own firmware. For a phone alarm, enable Smart Wake below and allow NOOP to schedule system alarms (iOS 26 or later). AlarmKit can alert through Silent mode and Focus, and its maximum-time alarm stays scheduled even when WHOOP heart-rate data is unavailable. Keep your built-in Clock alarm as a backup until you have tested Smart Wake on this iPhone." : {
      "comment" : "Footnote under 'The strap alarm is a silent buzz' on the Alarms screen.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sveglia qui sopra fa vibrare il polso dal firmware della fascia. Per una sveglia sul telefono, attiva Smart Wake qui sotto e consenti a NOOP di programmare sveglie di sistema (iOS 26 o successivo). AlarmKit può suonare anche con il silenzioso e la modalità Focus, e la sveglia all'orario massimo resta programmata anche senza dati di frequenza cardiaca del WHOOP. Tieni la sveglia dell'app Orologio come riserva finché non hai provato Smart Wake su questo iPhone."
          }
        }
      }
    },
    "Uses the same active weekdays and per-day wake times as the WHOOP alarm: %@." : {
      "comment" : "Footnote under the early window. %@ is a weekday summary such as 'Every day' or 'Mon, Tue'.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa gli stessi giorni attivi e gli stessi orari per giorno della sveglia WHOOP: %@."
          }
        }
      }
    },
    "Weekday" : {
      "comment" : "AppIntent parameter title (not discoverable).",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giorno della settimana"
          }
        }
      }
    },
    "Zone %lld, %@" : {
      "comment" : "VoiceOver label for a legend entry when no bpm range is available.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zona %1$lld, %2$@"
          }
        }
      }
    },
    "Zone %lld, %@, %lld beats per minute or more" : {
      "comment" : "VoiceOver label for the Zone 5 legend entry.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zona %1$lld, %2$@, da %3$lld battiti al minuto in su"
          }
        }
      }
    },
    "Zone %lld, %@, %lld to %lld beats per minute" : {
      "comment" : "VoiceOver label for a legend entry of Zones 1 to 4.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zona %1$lld, %2$@, da %3$lld a %4$lld battiti al minuto"
          }
        }
      }
    },
    "of 21" : {
      "comment" : "Caption under an Effort value on the WHOOP 0-21 scale.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "su 21"
          }
        }
      }
    },
    "phone" : {
      "comment" : "Source caption under a step count (measured by the phone).",
      "extractionState" : "manual",
      "localizations" : {
