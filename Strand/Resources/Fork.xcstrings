    "< %lld bpm" : {
      "comment" : "HR zone legend: heart rate strictly below the Zone 1 start.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "< %lld bpm"
          }
        }
      }
    },
    "A calm reminder timed from your usual wake time and your sleep need. It is a suggestion, not an alarm, and the usual wake time does not wake you." : {
      "comment" : "Information sheet: evening reminder.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un promemoria sereno calcolato dall'orario di sveglia abituale e dal tuo fabbisogno di sonno. È un suggerimento, non una sveglia, e l'orario abituale non ti sveglia."
          }
        }
      }
    },
    "Add alarm" : {
      "comment" : "VoiceOver label of the + button.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi sveglia"
          }
        }
      }
    },
    "Alarm permission is off for NOOP, so the iPhone alarm cannot ring" : {
      "comment" : "One-line warning on the Alarms screen.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il permesso Sveglie è disattivato per NOOP: la sveglia dell'iPhone non può suonare"
          }
        }
      }
    },
    "Alarm permission was revoked in Settings." : {
      "comment" : "Display text for SmartWakeAlarmScheduler.revokedAuthorizationMessage (the stored value stays English).",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il permesso per le sveglie è stato revocato in Impostazioni."
          }
        }
      }
    },
    "Apple Health would not remove earlier NOOP samples, so new ones were not written to avoid duplicates." : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salute non ha rimosso i campioni NOOP precedenti, quindi quelli nuovi non sono stati scritti per evitare duplicati."
          }
        }
      }
    },
    "Awake" : {
      "comment" : "Awake sleep legend in the Today Night card: time in bed not asleep.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
