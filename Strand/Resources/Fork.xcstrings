    },
    "NOOP could not schedule the system alarm. Check the Alarms permission and try again." : {
      "comment" : "Generic error under the Smart Wake card when AlarmKit scheduling fails. A technical detail line may follow it (English).",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOOP non è riuscito a programmare la sveglia di sistema. Controlla il permesso per le sveglie e riprova."
          }
        }
      }
    },
    "NOOP estimates light sleep from WHOOP heart rate and beat intervals and wakes you earlier inside the window, with the strap and the iPhone. It is an estimate, not a measured sleep stage. If samples are missing or insufficient, the maximum-time AlarmKit alarm remains scheduled." : {
      "comment" : "Smart Wake card explanation footnote.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOOP stima il sonno leggero dalla frequenza cardiaca e dagli intervalli tra i battiti del WHOOP e ti sveglia prima, dentro la finestra, con la fascia e l'iPhone. È una stima, non una fase del sonno misurata. Se i campioni mancano o non bastano, resta programmata la sveglia AlarmKit all'orario massimo."
          }
        }
      }
    },
    "Next alarm" : {
      "comment" : "Row label: when the next alarm or Smart Wake window ends.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prossima sveglia"
          }
        }
      }
    },
